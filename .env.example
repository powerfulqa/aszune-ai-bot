# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Perplexity Agent API (/v1/agent) - the only chat path since Sonar Chat
# Completions was retired on 2026-09-27.
# Preset: fast | low | medium | high | xhigh. Default: medium (good for
# back-and-forth conversation). The preset picks the model, reasoning effort,
# step budget and default tools.
AGENT_PRESET=medium
# Optional: pin a model on top of the preset (e.g. anthropic/claude-sonnet-5-5,
# openai/gpt-6-sol) and/or override reasoning effort (minimal|low|medium|high).
# Leave empty to follow the preset.
AGENT_MODEL=
AGENT_REASONING_EFFORT=
# Let the agent read links people paste (fetch_url tool). Default: true
AGENT_FETCH_URL=true

# Discord user IDs (comma-separated) allowed to run /diag, the private
# diagnostics command. Running /diag without being listed replies with your ID.
BOT_OWNER_IDS=
# Optional allowlist restricting web search to these domains (comma-separated)
SEARCH_DOMAIN_FILTER=

# Development Environment
NODE_ENV=production
DEBUG=false

# Dashboard Control - Systemd Service Configuration
SERVICE_NAME=aszune-bot

# Web Dashboard (http://<host>:3000)
# Bind address: 127.0.0.1 (default, localhost-only) or 0.0.0.0 to expose on the LAN
DASHBOARD_BIND_HOST=127.0.0.1
# Enables destructive dashboard operations (service control, config editor,
# reminder edits). Without it the dashboard is read-only on 127.0.0.1 and
# refuses API/live-data access on any other bind address. Access once as
# http://<host>:3000/#token=YOUR_TOKEN to save it in the browser.
DASHBOARD_TOKEN=your-dashboard-token
# systemd units listed on the dashboard's Services page (comma-separated, optional).
# Default: aszune-ai-bot,nginx,postgresql
# DASHBOARD_SERVICES=aszune-ai-bot

# Raspberry Pi Optimizations
ENABLE_PI_OPTIMIZATIONS=false
PI_LOG_LEVEL=ERROR
PI_DEBOUNCE_MS=300
PI_MAX_CONNECTIONS=2
PI_MEMORY_LIMIT=200
PI_MEMORY_CRITICAL=250
PI_COMPACT_MODE=false
PI_REACTION_LIMIT=3
PI_LOW_CPU_MODE=false
PI_STREAM_RESPONSES=true

# Performance Monitoring
MIN_VALID_INTERVAL_MS=250
BACKOFF_MAX_MS=10000
BACKOFF_MIN_MS=500
CHECK_INTERVAL_MS=5000
CPU_THRESHOLD_PERCENT=80
MEMORY_THRESHOLD_PERCENT=85

# Analytics Server (for usage metrics)
# For local deployment, use localhost
INSTANCE_TRACKING_SERVER=http://localhost:3001/api/beacon
TRACKING_ADMIN_KEY=your-secret-admin-key
# Comma-separated list of authorized IPs (your IP is auto-added)
AUTHORIZED_IPS=