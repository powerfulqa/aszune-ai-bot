{
  "name": "aszuneai",
  "version": "2.0.0",
  "description": "A Discord bot specialized in gaming lore, game logic, guides, and advice using the Perplexity API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "restart": "pkill -f 'node src/index.js' 2>/dev/null || true && sleep 1 && npm start",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "test:ci": "jest --ci --coverage --reporters=default --reporters=jest-junit",
    "test:critical": "jest --config=config/jest.critical-coverage.config.js --coverage",
    "test:critical:ci": "jest --config=config/jest.critical-coverage.config.js --coverage --silent --passWithNoTests --ci",
    "coverage:critical": "jest --config=config/jest.critical-coverage.config.js --coverage --coverageReporters=lcov --coverageReporters=text-summary",
    "precommit": "npm run test:critical:ci",
    "security": "npm audit --audit-level=high",
    "format:md": "prettier --write \"**/*.md\"",
    "coverage": "jest --coverage",
    "serve": "node src/index.js",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "lint": "eslint src __tests__",
    "lint:fix": "eslint src __tests__ --fix",
    "fix": "npm run lint:fix && npm run format",
    "quality:check": "npm run lint && npm run test:critical:ci",
    "quality:fix": "npm run lint:fix && npm run format",
    "security:dependencies": "npm audit --audit-level=moderate",
    "security:all": "npm run security && npm run security:dependencies"
  },
  "keywords": [
    "discord",
    "bot",
    "ai",
    "gaming",
    "perplexity",
    "nodejs",
    "raspberry-pi"
  ],
  "author": "Chris Haycock <powerfulqa@users.noreply.github.com>",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/powerfulqa/aszune-ai-bot.git"
  },
  "bugs": {
    "url": "https://github.com/powerfulqa/aszune-ai-bot/issues"
  },
  "homepage": "https://github.com/powerfulqa/aszune-ai-bot#readme",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chrono-node": "^2.10.1",
    "cors": "^2.8.6",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "jest-junit": "^17.0.0",
    "markdownlint-cli": "^0.49.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
